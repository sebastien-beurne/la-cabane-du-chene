# Site service: use a NEW project and NEW Mongo service for this repository.
APP_ENV=railway
DB_NAME=chene_railway
RAILWAY_MONGO_HOST=${{Mongo.RAILWAY_PRIVATE_DOMAIN}}
MONGO_URL=mongodb://appadmin:${{Mongo.MONGO_ADMIN_PASSWORD}}@${{Mongo.RAILWAY_PRIVATE_DOMAIN}}:27017/?authSource=admin&replicaSet=rs0&directConnection=true
PORT=8080
MEDIA_ROOT=/app/media
ADMIN_EMAIL=
OWNER_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
SITE_URL=
CORS_ORIGINS=
EMAIL_DELIVERY_MODE=disabled
EMERGENT_EMAIL_KEY=
EMERGENT_LLM_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
WEBHOOK_CRON_SECRET=
RAILWAY_DOCKERFILE_PATH=deploy/railway/Dockerfile
